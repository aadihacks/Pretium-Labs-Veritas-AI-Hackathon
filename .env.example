# This checkout is a detached preview. Database and account services are disabled.
# Do not add database credentials here. Environment variables cannot reconnect it.
HOST=127.0.0.1
PORT=8766

# Gemini text-chat backend (local-only while account services are detached).
# Enter your real key with: python -B start_gemini.py
# Or supply GEMINI_API_KEY privately in the server process environment.
# Never put a real key in this template or the Git-tracked .env.local.
# GEMINI_MODEL=gemini-3.1-flash-lite

# Optional private Learn service from Aadi's pretium-labs-learn application.
# Run that application on loopback port 8767, then set this and restart Python.
# PRETIUM_LEARN_PORT=8767

# Set 1 to show the maintenance page, then restart the preview.
PRETIUM_MAINTENANCE=0

# Optional HTTPS proxy settings for a separately authorized hosted preview.
# PRETIUM_PUBLIC_ORIGIN=https://example.com
# PRETIUM_TRUST_TLS_PROXY=1

# Gemini API key and model are supplied in the server process environment.
# Keep real keys out of this file and the tracked root .env.local.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
